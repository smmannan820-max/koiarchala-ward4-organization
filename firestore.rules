rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "A9NmMagl3QWO5WkSJszZiCmo1hk2";
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /blanket_applications/{id} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name','father','village','address','phone','familyMembers','details','status','createdAt']) &&
        request.resource.data.keys().hasAll(['name','father','village','address','phone','familyMembers','status','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.father is string && request.resource.data.father.size() <= 100 &&
        request.resource.data.village is string && request.resource.data.village.size() > 0 && request.resource.data.village.size() <= 120 &&
        request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 250 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.familyMembers is int && request.resource.data.familyMembers >= 1 && request.resource.data.familyMembers <= 30 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is string &&
        (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 500))
      );
      allow read, update, delete: if isAdmin();
    }
    match /blanket_final/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /counters/{id} {
      allow read, write: if isAdmin();
    }
    match /applications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /{collectionName}/{id} {
      allow read: if collectionName in ['members','committee','advisers','activities','finance','gallery','weekly_support','notices','settings'];
      allow write: if isAdmin() && collectionName in ['members','committee','advisers','activities','finance','gallery','weekly_support','notices','settings'];
    }
  }
}
