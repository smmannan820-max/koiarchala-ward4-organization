rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "A9NmMagl3QWO5WkSJszZiCmo1hk2";
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /blanket_applications/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /blanket_final/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /counters/{id} {
      allow read, write: if isAdmin();
    }\n    match /applications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /{collectionName}/{id} {
      allow read: if collectionName in ['members','committee','advisers','activities','finance','gallery','weekly_support','notices','settings'];
      allow write: if isAdmin() && collectionName in ['members','committee','advisers','activities','finance','gallery','weekly_support','notices','settings'];
    }
  }
}
